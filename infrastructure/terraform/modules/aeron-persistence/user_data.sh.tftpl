#!/bin/bash
# =============================================================================
# OmniBridge Aeron Persistence Host Bootstrap (Ubuntu 22.04)
# =============================================================================
# Prepares the host only: mounts the GP3 data volume at /opt and applies kernel
# tuning. Java, the AWS CLI and the applications are installed afterwards by
# scripts/deploy/setup-remote.sh, which deploys under /opt/<component>.
# =============================================================================

set -uo pipefail
exec > /var/log/omnibridge-bootstrap.log 2>&1

echo "=== OmniBridge aeron-persistence host bootstrap starting $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# -----------------------------------------------------------------------------
# Data volume -> /opt
# -----------------------------------------------------------------------------
# Nitro instances expose EBS as NVMe (/dev/nvme1n1), not the attachment name
# ${ebs_device}, so take the first whole disk that is not the root disk. The
# volume is attached after the instance starts; wait up to 10 minutes.

MOUNT_POINT="/opt"
ROOT_DISK="/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
DATA_DISK=""
for i in $(seq 1 120); do
  DATA_DISK=$(lsblk -dpno NAME,TYPE | awk -v root="$ROOT_DISK" '$2 == "disk" && $1 != root { print $1; exit }')
  [ -n "$DATA_DISK" ] && break
  sleep 5
done

if [ -z "$DATA_DISK" ]; then
  echo "WARNING: no data volume found; applications will run from the root disk"
else
  echo "Data volume: $DATA_DISK"
  if ! blkid "$DATA_DISK"; then
    mkfs.ext4 -q -L omnibridge-data "$DATA_DISK"
  fi
  if ! mountpoint -q "$MOUNT_POINT"; then
    # Carry over anything already in /opt before mounting over it
    mkdir -p /mnt/omnibridge-data
    mount "$DATA_DISK" /mnt/omnibridge-data
    cp -an "$MOUNT_POINT"/. /mnt/omnibridge-data/
    umount /mnt/omnibridge-data
    mount "$DATA_DISK" "$MOUNT_POINT"
    echo "UUID=$(blkid -s UUID -o value "$DATA_DISK") $MOUNT_POINT ext4 defaults,noatime,nofail 0 2" >> /etc/fstab
  fi
  chmod 755 "$MOUNT_POINT"
fi

# -----------------------------------------------------------------------------
# Kernel tuning
# -----------------------------------------------------------------------------
# Larger socket buffers and backlog for Aeron UDP.

cat > /etc/sysctl.d/99-omnibridge.conf << 'SYSCTL'
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.core.rmem_default=1048576
net.core.wmem_default=1048576
net.core.netdev_max_backlog=30000
SYSCTL
sysctl --system > /dev/null

cat > /etc/security/limits.d/99-omnibridge.conf << 'LIMITS'
*  soft  nofile   65535
*  hard  nofile   65535
*  soft  memlock  unlimited
*  hard  memlock  unlimited
LIMITS

echo "=== OmniBridge aeron-persistence host bootstrap complete $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
