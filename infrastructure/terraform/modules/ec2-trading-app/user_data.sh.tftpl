#!/bin/bash
# =============================================================================
# OmniBridge Trading Host Bootstrap (Ubuntu 22.04)
# =============================================================================
# Prepares the host only: mounts the GP3 data volume at /opt and applies kernel
# tuning. Java, the AWS CLI and the applications are installed afterwards by
# scripts/deploy/setup-remote.sh, which deploys under /opt/<component>.
# =============================================================================

set -uo pipefail
exec > /var/log/omnibridge-bootstrap.log 2>&1

echo "=== OmniBridge ${app_type} host bootstrap starting $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="

# -----------------------------------------------------------------------------
# Data volume -> /opt
# -----------------------------------------------------------------------------
# Nitro instances expose EBS as NVMe (/dev/nvme1n1), not the attachment name
# ${ebs_device}, so take the first whole disk that is not the root disk. The
# volume is attached after the instance starts; wait up to 10 minutes.

MOUNT_POINT="/opt"
ROOT_DISK="/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
DATA_DISK=""
for i in $(seq 1 120); do
  DATA_DISK=$(lsblk -dpno NAME,TYPE | awk -v root="$ROOT_DISK" '$2 == "disk" && $1 != root { print $1; exit }')
  [ -n "$DATA_DISK" ] && break
  sleep 5
done

if [ -z "$DATA_DISK" ]; then
  echo "WARNING: no data volume found; applications will run from the root disk"
else
  echo "Data volume: $DATA_DISK"
  if ! blkid "$DATA_DISK"; then
    mkfs.ext4 -q -L omnibridge-data "$DATA_DISK"
  fi
  if ! mountpoint -q "$MOUNT_POINT"; then
    # Carry over anything already in /opt before mounting over it
    mkdir -p /mnt/omnibridge-data
    mount "$DATA_DISK" /mnt/omnibridge-data
    cp -an "$MOUNT_POINT"/. /mnt/omnibridge-data/
    umount /mnt/omnibridge-data
    mount "$DATA_DISK" "$MOUNT_POINT"
    echo "UUID=$(blkid -s UUID -o value "$DATA_DISK") $MOUNT_POINT ext4 defaults,noatime,nofail 0 2" >> /etc/fstab
  fi
  chmod 755 "$MOUNT_POINT"
fi

# -----------------------------------------------------------------------------
# Kernel tuning
# -----------------------------------------------------------------------------
# TCP_NODELAY is a socket option the engine sets itself; there is no sysctl for it.

cat > /etc/sysctl.d/99-omnibridge.conf << 'SYSCTL'
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.core.rmem_default=1048576
net.core.wmem_default=1048576
net.ipv4.tcp_rmem=4096 1048576 16777216
net.ipv4.tcp_wmem=4096 1048576 16777216
net.ipv4.tcp_keepalive_time=60
net.ipv4.tcp_keepalive_intvl=10
net.ipv4.tcp_keepalive_probes=6
SYSCTL
sysctl --system > /dev/null

cat > /etc/security/limits.d/99-omnibridge.conf << 'LIMITS'
*  soft  nofile   65535
*  hard  nofile   65535
*  soft  memlock  unlimited
*  hard  memlock  unlimited
LIMITS

# -----------------------------------------------------------------------------
# Event-loop core isolation (scripts/deploy/latency-host-tuning.sh)
# -----------------------------------------------------------------------------
# The engines pin their event loop to cpu ${latency_cpu}. Isolating it and its
# hyperthread sibling needs kernel parameters, so the host reboots once; the
# completion line below is then written after that reboot, which is what
# wait-for-hosts.sh waits for.

%{ if latency_cpu > 0 ~}
cat > /usr/local/sbin/latency-host-tuning.sh << 'TUNING'
${tuning_script}
TUNING
chmod 755 /usr/local/sbin/latency-host-tuning.sh
if /usr/local/sbin/latency-host-tuning.sh apply ${latency_cpu}; then
  cat > /etc/systemd/system/omnibridge-bootstrap-done.service << 'UNIT'
[Unit]
Description=OmniBridge: bootstrap complete after the core isolation reboot
After=omnibridge-irq-affinity.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "=== OmniBridge ${app_type} host bootstrap complete (rebooted for core isolation) ===" >> /var/log/omnibridge-bootstrap.log; systemctl disable omnibridge-bootstrap-done.service'

[Install]
WantedBy=multi-user.target
UNIT
  systemctl enable omnibridge-bootstrap-done.service
  echo "=== Rebooting in 1 minute for the kernel command line $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
  # Scheduled, so that cloud-init finishes and does not run this script again
  shutdown -r +1
  exit 0
fi
echo "WARNING: core isolation not applied"
%{ endif ~}

echo "=== OmniBridge ${app_type} host bootstrap complete $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
