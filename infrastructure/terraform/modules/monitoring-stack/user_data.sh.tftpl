#!/bin/bash
# =============================================================================
# OmniBridge Monitoring Host Bootstrap (Ubuntu 22.04)
# =============================================================================
# Nothing to prepare at boot. scripts/deploy/setup-remote.sh installs Docker and
# deploys Prometheus, Grafana, Alertmanager and OmniView under /opt. Keeping the
# Grafana password and Slack webhook out of user_data also keeps them out of
# instance metadata.
# =============================================================================

exec > /var/log/omnibridge-monitoring-bootstrap.log 2>&1
echo "=== OmniBridge ${environment} monitoring host booted $(date -u +%Y-%m-%dT%H:%M:%SZ) ==="
